# Server & Application
APP_URL="http://localhost:3000"
PORT="3000"
TZ="Asia/Karachi"
NODE_ENV="development"

# Authentication & Bootstrap Admin (change password on first login)
JWT_SECRET="replace-with-a-strong-64-char-random-secret"
ADMIN_BOOTSTRAP_USERNAME="dotboys"
ADMIN_BOOTSTRAP_PASSWORD="admin"

# Database (SQLite active by default in ./data/dotboys.db; PostgreSQL vars for VPS/Docker)
SQLITE_DB_PATH="./data/dotboys.db"
POSTGRES_DB="dotboys_hostel"
POSTGRES_USER="dotboys_app"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# Official WhatsApp Business Cloud API (Meta Graph API v21.0)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="dotboys-webhook-verify"

# Email SMTP Integration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="DOT BOYS HOSTEL <noreply@dotboyshostel.pk>"

# Google Maps Embed / API Key (optional; public fallback map works without key)
GOOGLE_MAPS_API_KEY=""
